{
  "name": "embrune",
  "version": "0.0.20",
  "repository": "koalalord9999/Embrune",
  "author": "John Olivas",
  "description": "Runescape clone, but text based lol",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-items": "node generate-item-ids.js",
    "start": "vite",
    "build": "vite build",
    "package": "electron-builder build --win --publish always",
    "zip-web": "cd dist && powershell -Command \"Compress-Archive -Path * -DestinationPath ..\\Embrune_HTML5.zip -Force\"",
    "ship": "npm version patch && npm run build && npm run zip-web && npm run package"
  },
  "build": {
    "appId": "com.embrune.app",
    "publish": {
      "provider": "github",
      "owner": "koalalord9999",
      "repo": "Embrune"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "dist-exe"
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "bad-words": "^4.0.0",
    "electron-updater": "^6.8.3",
    "path": "^0.12.7",
    "pusher": "^5.3.3",
    "pusher-js": "^8.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.2.0",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@netlify/functions": "^5.1.5",
    "@types/bad-words": "^3.0.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^40.7.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
